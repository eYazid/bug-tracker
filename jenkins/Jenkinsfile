pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            environment {
                GOCACHE "${WORKSPACE}/.cache/go-build"
            }
            steps {
                sh 'mkdir -p "$GOCACHE"'
                sh 'echo "Running unit tests for backend..."'
                dir('bugtracker-backend') {
                    sh 'go test -v ./...'
                }
            }
        }
    }
}
