pipeline {
    agent any

    stages {
        stage ('Execute Tests') {
            parallel {
                stage('Unit Tests - Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            environment {
                GOPATH = "${WORKSPACE}/.gopath"
                GOMODCACHE = "${WORKSPACE}/.gopath/pkg/mod"
                GOCACHE = "${WORKSPACE}/.cache/go-build"
                HOME = "${WORKSPACE}"
            }
            steps {
                sh 'mkdir -p "$GOCACHE" "$GOMODCACHE" "$GOPATH"'
                sh 'echo "Running unit tests for backend..."'
                dir('bugtracker-backend') {
                    sh '''
                    go test -v ./... 2>&1 | go-junit-report > test-results.xml
                    go test -coverprofile=coverage.out -covermode=atomic ./...
                    go tool cover -html=coverage.out -o coverage.html
                    mkdir -p reports
                    mv coverage.html reports/
                    '''
                }
            }
            post {
                always {
                    junit 'bugtracker-backend/test-results.xml'
                    publishHTML target: [
                        reportDir: 'bugtracker-backend/reports',
                        reportFiles: 'coverage.html',
                        reportName: 'Backend Code Coverage'
                    ]
                }
            }
        }

        stage('Unit Tests - Frontend') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            environment {
                HOME = "${WORKSPACE}"
            }
            steps {
                sh 'echo "Running unit tests for frontend..."'
                dir('bugtracker-frontend') {
                    sh '''
                    npm ci
                    npm test
                    mv coverage reports/
                    '''
                }
            }
            post {
                always {
                    junit 'bugtracker-frontend/test-results.xml'
                    publishHTML target: [
                        reportDir: 'bugtracker-frontend/reports',
                        reportFiles: 'index.html',
                        reportName: 'Frontend Code Coverage'
                    ]
                }
            }
    }

            }
        }
}
}
